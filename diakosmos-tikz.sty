% Generic TikZ primitives used by the Diakosmos house style.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{diakosmos-tikz}[2026/10/28 v0.1.0 Diakosmos TikZ primitives]

\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,shadows.blur}

\tikzset{
  diakosmos/soft shadow/.style={
    blur shadow={
      shadow xshift=0pt,
      shadow yshift=-1.8mm,
      shadow blur radius=3.6mm,
      shadow blur steps=9,
      shadow opacity=34
    }
  },
  diakosmos/flow arrow/.style={
    -{Stealth[length=19pt,width=15pt]},
    line width=2.2pt,
    rounded corners=8pt
  },
  diakosmos/axis 3d/.style={
    -{Stealth[length=1.6mm,width=1.2mm]},
    line width=0.6pt
  }
}

% Draw a page-sized canvas whose coordinates are centimetres from the south-west corner of the page.
% Arguments: width (cm), height (cm), ground colour. The page needs a matching geometry.
\NewDocumentEnvironment{diakosmosCanvas}{m m m}{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay,line cap=round,line join=round]
  \begin{scope}[shift={(current page.south west)},x=1cm,y=1cm]
  \fill[#3] (0,0) rectangle (#1,#2);
}{%
  \end{scope}
  \end{tikzpicture}%
  \null}

% Stack five low-opacity rounded rectangles under the box (x1,y1)-(x2,y2), at a fixed depth.
% Arguments: x1, y1, x2, y2, in the units of the current picture.
\NewDocumentCommand{\diakosmosLayeredShadow}{m m m m}{%
  \foreach \diakosmos@layer in {1,...,5}{%
    \pgfmathsetlengthmacro\diakosmos@corner{6pt+0.22mm*\diakosmos@layer}%
    \fill[black,opacity=0.018,rounded corners=\diakosmos@corner]
      ({#1-0.02*\diakosmos@layer},{#2-0.07-0.02*\diakosmos@layer})
      rectangle ({#3+0.02*\diakosmos@layer},{#4-0.07+0.02*\diakosmos@layer});
  }%
}

% Draw three axes from the origin of a three-dimensional picture, without labels.
% Arguments: optional path options, such as the axis colour, then the lengths along x, y and z.
\NewDocumentCommand{\diakosmosAxesThree}{O{} m m m}{%
  \draw[diakosmos/axis 3d,#1] (0,0,0) -- (#2,0,0);
  \draw[diakosmos/axis 3d,#1] (0,0,0) -- (0,#3,0);
  \draw[diakosmos/axis 3d,#1] (0,0,0) -- (0,0,#4);
}

% Draw a filled tapered arrow along a quadratic Bézier spine.
% Arguments: fill, path options, tail, head, bend, tail half-width,
% neck half-width, arrowhead length, arrowhead half-width.
\NewDocumentCommand{\diakosmosTaperArrow}{O{black} O{} m m m m m m m}{%
  \begin{scope}
    \path
      let \p1 = ($#4-#3$), \n1 = {veclen(\x1,\y1)},
          \p2 = (\x1/\n1, \y1/\n1),
          \p3 = (-\y1/\n1, \x1/\n1)
      in
      coordinate (diakosmos-tail) at #3
      coordinate (diakosmos-head) at #4
      coordinate (diakosmos-neck) at ($#4-#8*(\p2)$)
      coordinate (diakosmos-bend) at ($($#3!0.5!(diakosmos-neck)$)+#5*(\p3)$)
      coordinate (diakosmos-tail-top) at ($#3+#6*(\p3)$)
      coordinate (diakosmos-tail-bottom) at ($#3-#6*(\p3)$)
      coordinate (diakosmos-neck-top) at ($(diakosmos-neck)+#7*(\p3)$)
      coordinate (diakosmos-neck-bottom) at ($(diakosmos-neck)-#7*(\p3)$)
      coordinate (diakosmos-control-top) at
        ($(diakosmos-bend)+0.5*#6*(\p3)+0.5*#7*(\p3)$)
      coordinate (diakosmos-control-bottom) at
        ($(diakosmos-bend)-0.5*#6*(\p3)-0.5*#7*(\p3)$)
      coordinate (diakosmos-wing-top) at ($(diakosmos-neck)+#9*(\p3)$)
      coordinate (diakosmos-wing-bottom) at ($(diakosmos-neck)-#9*(\p3)$);
    \path[fill=#1,#2]
      (diakosmos-tail-top)
      .. controls (diakosmos-control-top) and (diakosmos-control-top)
      .. (diakosmos-neck-top)
      -- (diakosmos-wing-top) -- (diakosmos-head) -- (diakosmos-wing-bottom)
      -- (diakosmos-neck-bottom)
      .. controls (diakosmos-control-bottom) and (diakosmos-control-bottom)
      .. (diakosmos-tail-bottom) -- cycle;
  \end{scope}%
}

\endinput
